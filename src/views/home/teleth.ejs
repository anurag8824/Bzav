  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #fff;
    }

    .header {
      display: flex;
      align-items: center;
      padding: 10px 20px;
      border-bottom: 1px solid #ddd;
    }

    .header img {
      height: 24px;
      margin-right: 10px;
    }

    .header button {
      margin-left: auto;
      background-color: #007bff;
      color: white;
      border: none;
      padding: 8px 12px;
      border-radius: 5px;
      font-size: 14px;
      cursor: pointer;
    }

    .container {
      text-align: center;
      padding: 40px 20px;
    }

    .logo-placeholder {
      width: 120px;
      height: 120px;
      background: #f0f0f0;
      border-radius: 50%;
      margin: 0 auto 20px;
    }

    .title {
      font-size: 24px;
      font-weight: bold;
    }

    .subscribers {
      color: gray;
      margin: 10px 0;
    }

    .text {
      margin: 20px 0;
      font-size: 16px;
    }

    .join-button {
      display: inline-block;
      margin-top: 20px;
      background-color: #0088cc;
      color: white;
      padding: 12px 24px;
      border: none;
      border-radius: 25px;
      font-size: 16px;
      text-decoration: none;
      cursor: pointer;
    }

    .invite-text {
      margin-top: 20px;
      color: #777;
      font-size: 14px;
    }
  </style>

